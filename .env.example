# Providers de IA (Google AI Studio continua sendo o padrão free-first)
# Chat: "google" (default) | "vertex" | "anthropic" | "openai"
CHAT_LLM_PROVIDER=google
CHAT_LLM_MODEL=gemini-2.5-flash-lite
# Compatibilidade temporária com instalações anteriores; prefira CHAT_LLM_PROVIDER.
LLM_PROVIDER=google

# Embeddings: "google" (default) | "vertex"
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536

# Google AI Studio — necessário quando chat ou embeddings usam "google".
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# Vertex AI opcional — autenticação exclusiva por ADC, sem chave JSON.
# Os valores por função prevalecem sobre os compartilhados.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_MODEL=gemini-2.5-flash-lite
CHAT_VERTEX_PROJECT=
CHAT_VERTEX_LOCATION=
EMBEDDING_VERTEX_PROJECT=
EMBEDDING_VERTEX_LOCATION=

# Providers opcionais somente para chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Governança free-first. Comece em "off", valide em "shadow" e só então use "enforce".
CHAT_GOVERNANCE_MODE=off
CHAT_LLM_KILL_SWITCH=false
CHAT_GOVERNANCE_EMERGENCY_BYPASS=false
CHAT_VISITOR_PER_MINUTE_LIMIT=4
CHAT_VISITOR_DAILY_LIMIT=50
CHAT_GLOBAL_DAILY_LIMIT=500
CHAT_OPERATIONAL_RESERVE_DAILY=50
CHAT_QUOTA_RESET_TIME_ZONE=America/Los_Angeles
CHAT_CONVERSATION_LEASE_TTL_SECONDS=60

# Orçamentos de tokens e RAG.
CHAT_HISTORY_TOKEN_BUDGET=4000
CHAT_RAG_TOKEN_BUDGET=2000
CHAT_TOTAL_INPUT_TOKEN_BUDGET=8000
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_RAG_MAX_CHUNKS=3
RAG_MATCH_THRESHOLD=0.3

# Cache persistente; habilite somente após aplicar as migrações.
CHAT_RESPONSE_CACHE_ENABLED=false
CHAT_RESPONSE_CACHE_TTL_SECONDS=86400
CHAT_EMBEDDING_CACHE_ENABLED=false
CHAT_EMBEDDING_CACHE_TTL_SECONDS=2592000

# Links públicos e URL canônica.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/DanielTrindade
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_RESUME_URL=

# Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sessão administrativa privada.
ADMIN_PASSWORD=

# Observabilidade (desabilitada até migrações, chaves e proxy estarem prontos).
CHAT_OBSERVABILITY_ENABLED=false
CHAT_TRUSTED_PROXY_HOPS=
CHAT_IP_HMAC_KEY_BASE64=
CHAT_IP_ENCRYPTION_KEYS_JSON=
CHAT_IP_ACTIVE_KEY_VERSION=v1
CHAT_IP_RETENTION_DAYS=7
CHAT_CONVERSATION_RETENTION_DAYS=30
CHAT_AUDIT_RETENTION_DAYS=90
