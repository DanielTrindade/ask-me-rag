[
  {
    "name": "keep-production",
    "action": { "type": "Keep" },
    "condition": { "tagState": "tagged", "tagPrefixes": ["production"] }
  },
  {
    "name": "keep-recent",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "keepCount": 3 }
  },
  {
    "name": "delete-old",
    "action": { "type": "Delete" },
    "condition": { "tagState": "any", "olderThan": "7d" }
  }
]
